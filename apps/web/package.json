{
  "name": "@binder/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:offline": "playwright test -c e2e/playwright.offline.config.ts",
    "e2e:all": "pnpm e2e && pnpm e2e:offline"
  },
  "dependencies": {
    "@binder/core": "workspace:*",
    "@binder/shared": "workspace:*",
    "@powersync/react": "^2.0.2",
    "@powersync/web": "^2.4.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.18",
    "better-auth": "^1.7.7",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@binder/db": "workspace:*",
    "@binder/fixtures": "workspace:*",
    "@playwright/test": "1.64.0",
    "@tanstack/router-plugin": "^1.168.45",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-orm": "^0.45.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
