# Binder environment. Copy to .env and edit. The values below work for local development.
#
# Run the API with this file loaded:
#   set -a; . ./.env; set +a; pnpm --filter @binder/api dev
# The dev compose stack (deploy/docker-compose.dev.yml) has the same dev defaults built in, so it
# needs no env file. Only set the compose variables below to override them.
#
# Generate a secret for anything that is not local development:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

# --- API (apps/api) ---------------------------------------------------------

# Postgres connection string. The dev compose stack serves this on localhost:5432.
DATABASE_URL=postgres://binder:binder@localhost:5432/binder

# Directory where uploaded PDFs and derived files are stored (created if missing).
BLOB_ROOT=./.data/blobs

# Port the API listens on.
PORT=3000

# Public origin of the web app, used for auth cookies, CORS and links in emails.
APP_ORIGIN=http://localhost:5173

# Secret for signing sessions; at least 32 characters.
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789

# base64url (no padding) shared secret the API signs PowerSync JWTs with. It must equal PS_JWT_SECRET
# below. This default is the dev value baked into docker-compose.dev.yml; never reuse it outside dev.
POWERSYNC_JWT_SECRET=YmluZGVyLWRldi1wb3dlcnN5bmMtc2VjcmV0LTMyYnk

# Where clients reach PowerSync. Returned as `endpoint` by GET /api/sync/token; the web app reads it
# from there and has no PowerSync URL setting of its own.
POWERSYNC_URL=http://localhost:8080

# Optional SMTP connection string for sign-in emails, e.g. smtp://user:pass@host:587. Unset: in
# development mail (sign-in links included) is logged; in production magic-link sign-in is disabled.
# SMTP_URL=

# Allow public email sign-up. Leave false: users are created with the CLI (`create-user`).
ALLOW_SIGNUP=false

# --- Dev compose stack (deploy/docker-compose.dev.yml) -----------------------
# All optional; the defaults match the API values above.

# POSTGRES_USER=binder
# POSTGRES_PASSWORD=binder
# POSTGRES_DB=binder

# PowerSync's source (the app database, as the replication role) and its own bucket storage database.
# The role and storage database are created by deploy/postgres/init.sql.
# PS_DATA_SOURCE_URI=postgresql://powersync_role:powersync_dev_password@postgres:5432/binder
# PS_STORAGE_SOURCE_URI=postgresql://powersync_role:powersync_dev_password@postgres:5432/powersync_storage

# Same value as POWERSYNC_JWT_SECRET.
# PS_JWT_SECRET=YmluZGVyLWRldi1wb3dlcnN5bmMtc2VjcmV0LTMyYnk
