# Serves the web build and proxies the API. TLS is terminated upstream (Cloudflare, then Traefik), so
# this listens on plain HTTP only.
{
	auto_https off
	admin off
}

:80 {
	# flush_interval -1 streams responses as they are produced (MCP's streamable HTTP, large blobs).
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /blobs/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /mcp* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Hashed build output and the PDF.js assets never change under the same URL. No SPA fallback here:
	# a missing hashed file must 404 rather than be cached for a year as index.html.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /pdfjs/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else, including index.html and the service worker, must be revalidated so an update
	# is seen on the next visit. Unknown paths fall back to the SPA shell.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
