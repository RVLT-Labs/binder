# Serves the web build and proxies the API. TLS is terminated upstream (Cloudflare, then Traefik), so
# this listens on plain HTTP only.
{
	auto_https off
	admin off
	# Traffic arrives through Cloudflare's tunnel and Coolify's Traefik, both on private addresses.
	# Trusting them keeps the client's X-Forwarded-For instead of replacing it with Traefik's address,
	# which would put every user in one rate-limit bucket in the API. CF-Connecting-IP is kept only for
	# requests that really came through the tunnel (see the site block).
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# CF-Connecting-IP is only true when the tunnel set it. Traefik appends the address it received the
	# request from to X-Forwarded-For, so the last entry is that hop: private for the local cloudflared
	# container, public for anyone who reached Traefik on the host's public IP directly. Such a client
	# can forge CF-Connecting-IP (a fresh rate-limit bucket per request), so the header is dropped
	# unless that last hop is private. The API then falls back to X-Forwarded-For, read from the right
	# past private proxies, which is the direct client's real address.
	@notViaTunnel not header_regexp X-Forwarded-For `(?i)(?:^|,)\s*(?:10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|127\.\d{1,3}\.\d{1,3}\.\d{1,3}|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}|::1|f[cd][0-9a-f]{0,2}:[0-9a-f:]*|::ffff:(?:10|127)\.[0-9.]+|::ffff:192\.168\.[0-9.]+|::ffff:172\.(?:1[6-9]|2\d|3[01])\.[0-9.]+)\s*$`
	request_header @notViaTunnel -Cf-Connecting-Ip

	# JSON-only endpoints, including the unauthenticated auth routes: refuse bodies over 2 MiB here,
	# before the API reads them (the API enforces the same limit). Uploads keep their 200 MB limit.
	@jsonOnly path /api/auth/* /mcp /mcp/*
	request_body @jsonOnly {
		max_size 2MiB
	}

	# flush_interval -1 streams responses as they are produced (MCP's streamable HTTP, large blobs).
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /blobs/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /mcp* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Hashed build output never changes under the same URL. No SPA fallback here: a missing hashed file
	# must 404 rather than be cached for a year as index.html.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The PDF.js assets are not content-hashed, so a pdfjs-dist upgrade replaces files under the same
	# URLs: cache them for a day, not forever. (The service worker precaches them per build anyway.)
	handle /pdfjs/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else, including index.html and the service worker, must be revalidated so an update
	# is seen on the next visit. Unknown paths fall back to the SPA shell.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
