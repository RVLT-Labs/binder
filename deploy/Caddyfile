# Serves the web build and proxies the API. TLS is terminated upstream (Cloudflare, then Traefik), so
# this listens on plain HTTP only.
{
	auto_https off
	admin off
	# Traffic arrives through Cloudflare's tunnel and Coolify's Traefik, both on private addresses.
	# Trusting them keeps the client's X-Forwarded-For (and CF-Connecting-IP, which is passed through
	# untouched) instead of replacing it with Traefik's address, which would put every user in one
	# rate-limit bucket in the API.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# flush_interval -1 streams responses as they are produced (MCP's streamable HTTP, large blobs).
	handle /api/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /blobs/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	handle /mcp* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Hashed build output never changes under the same URL. No SPA fallback here: a missing hashed file
	# must 404 rather than be cached for a year as index.html.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The PDF.js assets are not content-hashed, so a pdfjs-dist upgrade replaces files under the same
	# URLs: cache them for a day, not forever. (The service worker precaches them per build anyway.)
	handle /pdfjs/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else, including index.html and the service worker, must be revalidated so an update
	# is seen on the next visit. Unknown paths fall back to the SPA shell.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
